# NOTE: nothing in this project reads a .env file automatically. This file only documents the variable names.
# Set them in front of the command instead, e.g.
#   macOS / Linux : COMPLAINT_THRESHOLD=0.8 python scripts/run_app.py
#   Windows cmd   : set COMPLAINT_THRESHOLD=0.8 && python scripts/run_app.py
COMPLAINT_THRESHOLD=0.5
CATEGORY_MIN_CONFIDENCE=0.5
API_KEY=
MODELS_DIR=./models
QSR_API_URL=http://127.0.0.1:8000
